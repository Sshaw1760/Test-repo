# 5. LOGISTIC FUNCTION
# ============================================================

def logistic(k, x, n):
    # Calculate one logistic function value
    # Repeat the function n times

    for i in range(n):
        x = k * x * (1 - x)

    return x


def problem5():
    print("\n--- Problem 5: Logistic Function ---")

    k = float(input("Enter k: "))
    x = float(input("Enter starting x: "))
    n = int(input("Enter n: "))

    result = logistic(k, x, n)

    print("Logistic function value:", result)


