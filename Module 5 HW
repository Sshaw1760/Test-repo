# 1. CHAOS FUNCTION
# ============================================================

def chaos(k, x, n):
    # Logistic function: k * x * (1 - x)
    # Generate and print n values

    for i in range(n):
        x = k * x * (1 - x)
        print(x)


def problem1():
    print("\n--- Problem 1: Chaos Function ---")

    k = float(input("Enter k: "))
    x = float(input("Enter starting x: "))
    n = int(input("Enter number of values to generate: "))

    chaos(k, x, n)


