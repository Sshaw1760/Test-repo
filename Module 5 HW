# 2. KELVIN TO FAHRENHEIT
# ============================================================

def kToF(k):
    # Convert Kelvin to Fahrenheit
    return (k - 273.15) * 9 / 5 + 32


def problem2():
    print("\n--- Problem 2: Kelvin to Fahrenheit ---")
    print("Kelvin\tFahrenheit")
    print("--------------------")

    for k in range(0, 301, 20):
        print(k, "\t", kToF(k))


# ============================================================
# 3. LOAN PAYMENT CALCULATOR
# ============================================================

def calcPmt(P0, r, k, N):
    # P0 = amount financed
    # r = annual interest rate
    # k = number of times compounded per year
    # N = number of years

    d = P0 / ((1 - (1 + r / k) ** (-N * k)) / (r / k))

    return d


def problem3():
    print("\n--- Problem 3: Loan Payment Calculator ---")

    P0 = float(input("Enter amount to finance: "))
    r = float(input("Enter annual interest rate as a decimal: "))
    k = int(input("Enter number of times interest is compounded per year: "))
    N = int(input("Enter number of years: "))

    payment = calcPmt(P0, r, k, N)

    print("Monthly payment:", payment)


# ============================================================
# 4. DRAW AN N-SIDED POLYGON USING ZELLE GRAPHICS
# ============================================================

def drawNGon(n, center, radius):
    # Calculate the angle between each side
    angle = 360 / n

    # Empty list for vertices
    vertices = []

    # Calculate each vertex
    for i in range(n):
        current_angle = math.radians(i * angle)

        x = center.getX() + radius * math.cos(current_angle)
        y = center.getY() + radius * math.sin(current_angle)

        vertices.append(Point(x, y))

    # Create polygon
    polygon = Polygon(vertices)

    return polygon


def graphPolygon(win, entry):
    # Wait for the user to click
    win.getMouse()

    # Get number of sides
    n = int(entry.getText())

    # Center of polygon
    center = Point(300, 250)

    # Radius of polygon
    radius = 150

    # Draw the polygon
    polygon = drawNGon(n, center, radius)
    polygon.setFill("lightblue")
    polygon.setOutline("black")
    polygon.draw(win)

    # Change button to Exit
    return polygon


