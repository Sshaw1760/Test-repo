# PROBLEM 1: Loan Amortization Schedule
# ------------------------------------------
def generate_amortization_schedule():
    print("\n--- 1. Loan Amortization Schedule ---")
    try:
        p0 = float(input("Enter loan amount financed ($): "))
        annual_rate = float(input("Enter annual interest rate (e.g., 0.06 for 6%): "))
        k = int(input("Enter number of compounding periods per year (e.g., 12 for monthly): "))
        years = int(input("Enter loan duration in years: "))
    except ValueError:
        print("[Error] Invalid numerical input. Returning to menu.")
        return

    total_payments = years * k
    periodic_rate = annual_rate / k
    
    if periodic_rate > 0:
        pmt = p0 * (periodic_rate) / (1 - (1 + periodic_rate) ** (-total_payments))
    else:
        pmt = p0 / total_payments
        
    print(f"\n{'='*75}")
    print(f"LOAN AMORTIZATION SCHEDULE")
    print(f"Principal: ${p0:,.2f} | Annual Rate: {annual_rate*100}% | Term: {years} Years ({k} payments/yr)")
    print(f"Periodic Payment: ${pmt:,.2f}")
    print(f"{'='*75}")
    print(f"{'Pmt #':<8} {'Payment':<12} {'Interest':<12} {'Principal':<12} {'Balance':<15}")
    print(f"{'-'*75}")
    
    balance = p0
    for pmt_num in range(1, total_payments + 1):
        interest_payment = balance * periodic_rate
        principal_payment = pmt - interest_payment
        balance -= principal_payment
        
        if balance < 0:
            balance = 0.0
            
        print(f"{pmt_num:<8} ${pmt:<11.2f} ${interest_payment:<11.2f} ${principal_payment:<11.2f} ${balance:<14.2f}")
    print(f"{'='*75}\n")


