# PROBLEM 4: Keyword Substitution Cipher
# ------------------------------------------
def create_substitution_alphabet(keyword):
    keyword = keyword.upper()
    seen = set()
    sub_alpha = []
    for char in keyword:
        if char.isalpha() and char not in seen:
            seen.add(char)
            sub_alpha.append(char)
    for ascii_val in range(ord('A'), ord('Z') + 1):
        char = chr(ascii_val)
        if char not in seen:
            sub_alpha.append(char)
    return "".join(sub_alpha)

def keyword_sub_encode(message, keyword):
    std_alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    sub_alpha = create_substitution_alphabet(keyword)
    trans_table = str.maketrans(std_alpha + std_alpha.lower(), sub_alpha + sub_alpha.lower())
    return message.translate(trans_table)

def keyword_sub_decode(ciphertext, keyword):
    std_alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    sub_alpha = create_substitution_alphabet(keyword)
    trans_table = str.maketrans(sub_alpha + sub_alpha.lower(), std_alpha + std_alpha.lower())
    return ciphertext.translate(trans_table)

def keyword_sub_demo():
    print("\n--- 4. Keyword Substitution Cipher Demo ---")
    msg = input("Enter message: ").strip()
    if not msg:
        msg = "PYTHON"
    kw = input("Enter keyword (e.g., PYTHON): ").strip()
    if not kw:
        kw = "PYTHON"
        
    encoded = keyword_sub_encode(msg, kw)
    decoded = keyword_sub_decode(encoded, kw)
    print(f"Encoded: {encoded}")
    print(f"Decoded: {decoded}")


