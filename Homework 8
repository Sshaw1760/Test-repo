# PROBLEM 3: Date Shift Cipher
# ------------------------------------------
def date_shift_encode(message, date_str):
    digits = [int(ch) for ch in date_str if ch.isdigit()]
    if not digits:
        raise ValueError("Date string must contain digits.")
    encoded_chars = []
    digit_idx = 0
    
    for char in message:
        if char.isalpha():
            shift = digits[digit_idx % len(digits)]
            base = ord('A') if char.isupper() else ord('a')
            encoded_char = chr((ord(char) - base + shift) % 26 + base)
            encoded_chars.append(encoded_char)
            digit_idx += 1
        else:
            encoded_chars.append(char)
    return "".join(encoded_chars)

def date_shift_decode(ciphertext, date_str):
    digits = [int(ch) for ch in date_str if ch.isdigit()]
    decoded_chars = []
    digit_idx = 0
    
    for char in ciphertext:
        if char.isalpha():
            shift = digits[digit_idx % len(digits)]
            base = ord('A') if char.isupper() else ord('a')
            decoded_char = chr((ord(char) - base - shift) % 26 + base)
            decoded_chars.append(decoded_char)
            digit_idx += 1
        else:
            decoded_chars.append(char)
    return "".join(decoded_chars)

def date_shift_demo():
    print("\n--- 3. Date Shift Cipher Demo ---")
    msg = input("Enter message to encode: ").strip()
    if not msg:
        msg = "Hello World"
    date_str = input("Enter agreed date (e.g., 5/3/24): ").strip()
    if not date_str:
        date_str = "5/3/24"
        
    encoded = date_shift_encode(msg, date_str)
    decoded = date_shift_decode(encoded, date_str)
    print(f"Encoded: {encoded}")
    print(f"Decoded: {decoded}")


