# PROBLEM 2: Scytale Cipher
# ------------------------------------------
def scytale_encipher(plaintext, radius):
    msg = plaintext.replace(" ", "").upper()
    remainder = len(msg) % radius
    if remainder != 0:
        msg = msg.ljust(len(msg) + (radius - remainder), 'X')
        
    rows = radius
    cols = len(msg) // rows
    grid = [list(msg[i * cols:(i + 1) * cols]) for i in range(rows)]
    
    ciphertext = []
    for c in range(cols):
        for r in range(rows):
            ciphertext.append(grid[r][c])
    return "".join(ciphertext)

def scytale_decipher(ciphertext, radius):
    rows = radius
    cols = len(ciphertext) // rows
    grid = [['' for _ in range(cols)] for _ in range(rows)]
    
    idx = 0
    for c in range(cols):
        for r in range(rows):
            grid[r][c] = ciphertext[idx]
            idx += 1
            
    plaintext = []
    for r in range(rows):
        for c in range(cols):
            plaintext.append(grid[r][c])
    return "".join(plaintext)

def scytale_demo():
    print("\n--- 2. Scytale Cipher Demo ---")
    msg = input("Enter message (e.g., PGMNIPHIORRMGTYOSOOAIWHTNCL): ").strip()
    if not msg:
        msg = "PGMNIPHIORRMGTYOSOOAIWHTNCL"
    try:
        radius = int(input("Enter cylinder radius / row count (e.g., 3): "))
    except ValueError:
        radius = 3
        
    encrypted = scytale_encipher(msg, radius)
    decrypted = scytale_decipher(encrypted, radius)
    print(f"Enciphered: {encrypted}")
    print(f"Deciphered: {decrypted}")


