# PROBLEM 5: Polybius Checkerboard Cipher
# ------------------------------------------
POLYBIUS_BOARD = [
    ['A', 'B', 'C', 'D', 'E'],
    ['F', 'G', 'H', 'I', 'K'], # I and J combined
    ['L', 'M', 'N', 'O', 'P'],
    ['Q', 'R', 'S', 'T', 'U'],
    ['V', 'W', 'X', 'Y', 'Z']
]

def locate_letter(board, letter):
    letter = letter.upper()
    if letter == 'J':
        letter = 'I'
    for r_idx, row in enumerate(board):
        if letter in row:
            return (r_idx, row.index(letter))
    return None

def encrypt_polybius(message, board):
    ciphertext = []
    for char in message.upper():
        if char.isalpha():
            coords = locate_letter(board, char)
            if coords:
                ciphertext.append(f"{coords[0]}{coords[1]}")
    return " ".join(ciphertext)

def decrypt_polybius(ciphertext, board):
    plaintext = []
    pairs = ciphertext.split()
    for pair in pairs:
        if len(pair) == 2 and pair.isdigit():
            r = int(pair[0])
            c = int(pair[1])
            if 0 <= r < len(board) and 0 <= c < len(board[0]):
                plaintext.append(board[r][c])
    return "".join(plaintext)

def polybius_demo():
    print("\n--- 5. Polybius Checkerboard Cipher Demo ---")
    msg = input("Enter message (e.g., PYTHON): ").strip()
    if not msg:
        msg = "PYTHON"
        
    encrypted = encrypt_polybius(msg, POLYBIUS_BOARD)
    decrypted = decrypt_polybius(encrypted, POLYBIUS_BOARD)
    print(f"Encrypted: {encrypted}")
    print(f"Decrypted: {decrypted}")


