# =====================================================================

class PhysicsBall:
    """Encapsulates a bouncing ball with gravitational physics and collision elasticity."""
    def __init__(self, canvas_width, canvas_height, radius, color):
        self.radius = radius
        self.x = random.randint(radius, canvas_width - radius)
        self.y = random.randint(radius, canvas_height // 2)
        self.vx = random.uniform(-4, 4)
        self.vy = random.uniform(0, 3)
        self.gravity = 0.5
        self.restitution = 0.8
        self.color = color
        self.width = canvas_width
        self.height = canvas_height
        self.item = None

    def update(self):
        self.vy += self.gravity
        self.x += self.vx
        self.y += self.vy
        
        if self.y + self.radius >= self.height:
            self.y = self.height - self.radius
            self.vy = -self.vy * self.restitution
            self.vx *= 0.98
            
        if self.y - self.radius <= 0:
            self.y = self.radius
            self.vy = -self.vy * self.restitution
            
        if self.x - self.radius <= 0 or self.x + self.radius >= self.width:
            self.vx = -self.vx * self.restitution
            self.x = max(self.radius, min(self.x, self.width - self.radius))


class BouncingSimulation:
    def __init__(self, width=600, height=600):
        self.root = tk.Tk()
        self.root.title("Three-Ball Bouncing Physics Simulation")
        
        self.width = width
        self.height = height
        
        self.canvas = tk.Canvas(self.root, width=self.width, height=self.height, bg="white")
        self.canvas.pack()
        
        colors = ["red", "blue", "green"]
        self.balls = [PhysicsBall(self.width, self.height, radius=20, color=c) for c in colors]
        
        for ball in self.balls:
            ball.item = self.canvas.create_oval(
                ball.x - ball.radius, ball.y - ball.radius,
                ball.x + ball.radius, ball.y + ball.radius,
                fill=ball.color
            )
            
        self.animating = True
        self.animate()

    def animate(self):
        if self.animating:
            for ball in self.balls:
                ball.update()
                self.canvas.coords(
                    ball.item,
                    ball.x - ball.radius, ball.y - ball.radius,
                    ball.x + ball.radius, ball.y + ball.radius
                )
            self.root.after(20, self.animate)

    def run(self):
        self.root.mainloop()
