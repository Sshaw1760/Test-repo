# PROBLEMS 3 & 4: Ship, Captain, and Crew Game & Interfaces
# =====================================================================

class SCCDie:
    def roll(self):
        return random.randint(1, 6)


class DiceCup:
    def __init__(self):
        self.dice = [SCCDie() for _ in range(5)]
        self.ship = False
        self.captain = False
        self.crew = False
        self.cargo = []
        
    def roll_remaining(self):
        new_dice = []
        for d in self.dice:
            val = d.roll()
            if not self.ship and val == 6:
                self.ship = True
            elif self.ship and not self.captain and val == 5:
                self.captain = True
            elif self.ship and self.captain and not self.crew and val == 4:
                self.crew = True
            else:
                new_dice.append(val)
        self.cargo = new_dice

    def get_score(self):
        if self.ship and self.captain and self.crew:
            return sum(self.cargo)
        return 0


class SCCPlayer:
    def __init__(self, name):
        self.name = name
        self.score = 0


class SCCInterface(ABC):
    """Abstract interface defining the contract for textual and GUI interfaces."""
    @abstractmethod
    def show_message(self, message):
        pass

    @abstractmethod
    def prompt_roll(self, player_name, attempt):
        pass

    @abstractmethod
    def ask_reroll_cargo(self):
        pass

    @abstractmethod
    def display_cup_state(self, cup):
        pass


class SCCTextInterface(SCCInterface):
    def show_message(self, message):
        print(message)

    def prompt_roll(self, player_name, attempt):
        input(f"[{player_name}'s Turn - Roll {attempt}] Press Enter to roll...")

    def ask_reroll_cargo(self):
        choice = input("You have Ship, Captain, and Crew! Reroll cargo for a better score? (y/n): ")
        return choice.lower() == 'y'

    def display_cup_state(self, cup):
        print(f"Status -> Ship(6): {cup.ship} | Captain(5): {cup.captain} | Crew(4): {cup.crew} | Cargo: {cup.cargo}")


class SCCGUIInterface(SCCInterface, tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Ship, Captain, and Crew Game")
        self.geometry("450x400")

        self.msg_var = tk.StringVar(value="Welcome to Ship, Captain, and Crew!")
        self.status_var = tk.StringVar(value="")

        tk.Label(self, textvariable=self.msg_var, font=("Arial", 12, "bold"), wraplength=400).pack(pady=20)
        tk.Label(self, textvariable=self.status_var, font=("Arial", 10), justify=tk.LEFT).pack(pady=10)

        self.action_btn = tk.Button(self, text="Roll Dice", command=self.on_action, font=("Arial", 11), bg="#2196F3", fg="white")
        self.action_btn.pack(pady=10)

        self.reroll_btn = tk.Button(self, text="Keep Score & End Turn", command=self.on_keep, font=("Arial", 11), bg="#f44336", fg="white")
        self.reroll_btn.pack(pady=5)
        self.reroll_btn.pack_forget()

        self.user_choice = None
        self.action_clicked = False

    def show_message(self, message):
        self.msg_var.set(message)
        self.update()

    def prompt_roll(self, player_name, attempt):
        self.msg_var.set(f"{player_name}'s Turn (Roll {attempt}/3). Click Roll.")
        self.reroll_btn.pack_forget()
        self.action_clicked = False
        while not self.action_clicked:
            self.update_idletasks()
            self.update()

    def ask_reroll_cargo(self):
        self.msg_var.set("Ship, Captain & Crew secured! Roll again or keep score?")
        self.reroll_btn.pack(pady=5)
        self.user_choice = None
        while self.user_choice is None:
            self.update_idletasks()
            self.update()
        self.reroll_btn.pack_forget()
        return self.user_choice

    def display_cup_state(self, cup):
        status = f"Ship (6): {'Yes' if cup.ship else 'No'}\n"
        status += f"Captain (5): {'Yes' if cup.captain else 'No'}\n"
        status += f"Crew (4): {'Yes' if cup.crew else 'No'}\n"
        status += f"Cargo Dice: {cup.cargo}\n"
        status += f"Current Cargo Score: {cup.get_score()}"
        self.status_var.set(status)
        self.update()

    def on_action(self):
        self.action_clicked = True
        self.user_choice = True

    def on_keep(self):
        self.user_choice = False


class ShipCaptainCrewGame:
    def __init__(self, player_names, interface_type="text"):
        self.players = [SCCPlayer(name) for name in player_names]
        if interface_type == "gui":
            self.ui = SCCGUIInterface()
        else:
            self.ui = SCCTextInterface()

    def play_turn(self, player):
        cup = DiceCup()
        self.ui.show_message(f"--- {player.name}'s Turn ---")
        for attempt in range(1, 4):
            self.ui.prompt_roll(player.name, attempt)
            cup.roll_remaining()
            self.ui.display_cup_state(cup)
            
            if cup.ship and cup.captain and cup.crew and attempt < 3:
                if not self.ui.ask_reroll_cargo():
                    break
                    
        player.score = cup.get_score()
        self.ui.show_message(f"{player.name}'s final turn score: {player.score}")

    def play(self):
        for player in self.players:
            self.play_turn(player)
        
        highest_score = max(p.score for p in self.players)
        winners = [p for p in self.players if p.score == highest_score]
        
        if len(winners) == 1:
            self.ui.show_message(f"Winner: {winners[0].name} with a score of {winners[0].score}!")
        else:
            names = ", ".join([w.name for w in winners])
            self.ui.show_message(f"Tie between: {names} with {highest_score} points!")


