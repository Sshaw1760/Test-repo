# PROBLEMS 1 & 2: LCR (Left Center Right) Game & Interfaces
# =====================================================================

class LCRDie:
    """Represents a 6-sided LCR die: L, R, C, and 3 dots (safe)."""
    FACES = ['L', 'R', 'C', '.', '.', '.']
    
    def roll(self):
        return random.choice(self.FACES)


class LCRPlayer:
    def __init__(self, name, chips=3):
        self.name = name
        self.chips = chips
        
    def add_chips(self, amount):
        self.chips += amount
        
    def remove_chips(self, amount):
        self.chips = max(0, self.chips - amount)


class LCRPot:
    def __init__(self):
        self.chips = 0
        
    def add(self, amount):
        self.chips += amount
        
    def take_all(self):
        val = self.chips
        self.chips = 0
        return val


class LCRInterface(ABC):
    """Abstract interface defining the contract for textual and GUI interfaces."""
    @abstractmethod
    def show_message(self, message):
        pass
        
    @abstractmethod
    def prompt_turn(self, player_name):
        pass
        
    @abstractmethod
    def update_status(self, players, pot):
        pass


class LCRTextInterface(LCRInterface):
    def show_message(self, message):
        print(message)
        
    def prompt_turn(self, player_name):
        input(f"[{player_name}'s turn] Press Enter to roll...")
        
    def update_status(self, players, pot):
        status = ", ".join([f"{p.name}: {p.chips}" for p in players])
        print(f"Status -> Pot: {pot.chips} chips | {status}\n")


class LCRGUIInterface(LCRInterface, tk.Tk):
    def __init__(self, game_engine=None):
        super().__init__()
        self.game_engine = game_engine
        self.title("LCR Game Simulation")
        self.geometry("450x400")
        
        self.msg_var = tk.StringVar(value="Welcome to LCR!")
        self.status_var = tk.StringVar(value="")
        
        tk.Label(self, textvariable=self.msg_var, font=("Arial", 12, "bold"), wraplength=400).pack(pady=20)
        self.status_label = tk.Label(self, textvariable=self.status_var, font=("Arial", 10), justify=tk.LEFT)
        self.status_label.pack(pady=10)
        
        self.roll_btn = tk.Button(self, text="Roll / Continue", command=self.on_roll_clicked, font=("Arial", 11), bg="#4CAF50", fg="white")
        self.roll_btn.pack(pady=20)
        
        self.turn_ready = False

    def show_message(self, message):
        self.msg_var.set(message)
        self.update()

    def prompt_turn(self, player_name):
        self.msg_var.set(f"{player_name}'s turn. Click Roll.")
        self.turn_ready = False
        while not self.turn_ready:
            self.update_idletasks()
            self.update()

    def update_status(self, players, pot):
        status = f"Center Pot: {pot.chips} chips\n\nPlayers:\n"
        for p in players:
            status += f" - {p.name}: {p.chips} chips\n"
        self.status_var.set(status)

    def on_roll_clicked(self):
        self.turn_ready = True


class LCRGame:
    def __init__(self, player_names, interface_type="text"):
        self.players = [LCRPlayer(name) for name in player_names]
        self.pot = LCRPot()
        self.die = LCRDie()
        
        if interface_type == "gui":
            self.ui = LCRGUIInterface(self)
        else:
            self.ui = LCRTextInterface()

    def play(self):
        active_players = self.players
        round_num = 1
        
        while len([p for p in active_players if p.chips > 0]) > 1:
            self.ui.show_message(f"--- Round {round_num} ---")
            self.ui.update_status(self.players, self.pot)
            
            for i, player in enumerate(active_players):
                if player.chips == 0:
                    continue
                
                self.ui.prompt_turn(player.name)
                
                rolls_count = min(player.chips, 3)
                rolls = [self.die.roll() for _ in range(rolls_count)]
                self.ui.show_message(f"{player.name} rolled: {rolls}")
                
                for face in rolls:
                    if face == 'L':
                        target = active_players[(i - 1) % len(active_players)]
                        player.remove_chips(1)
                        target.add_chips(1)
                    elif face == 'R':
                        target = active_players[(i + 1) % len(active_players)]
                        player.remove_chips(1)
                        target.add_chips(1)
                    elif face == 'C':
                        player.remove_chips(1)
                        self.pot.add(1)
                
                self.ui.update_status(self.players, self.pot)
                
                remaining = [p for p in self.players if p.chips > 0]
                if len(remaining) == 1:
                    winner = remaining[0]
                    winner.add_chips(self.pot.take_all())
                    self.ui.show_message(f"Game Over! {winner.name} wins the game and the pot!")
                    return
            round_num += 1


