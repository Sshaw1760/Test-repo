# Problem 2
# Button program
# ---------------------------------------------------------

def buttonClicked(point, button):
    p1 = button.getP1()
    p2 = button.getP2()

    x = point.getX()
    y = point.getY()

    left = p1.getX()
    right = p2.getX()
    top = p1.getY()
    bottom = p2.getY()

    if left <= x <= right and top <= y <= bottom:
        return True
    else:
        return False


def problem2():
    print("\nProblem 2 - Button")

    win = GraphWin("Button", 400, 300)

    button = Rectangle(Point(150, 120), Point(250, 180))
    button.setFill("lightgray")
    button.draw(win)

    label = Text(Point(200, 150), "Click Me")
    label.draw(win)

    # Keep waiting until the button is clicked
    while True:
        point = win.getMouse()

        if buttonClicked(point, button):
            break

    label.setText("Button Clicked!")

    win.getMouse()
    win.close()


