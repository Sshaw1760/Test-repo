# Problem 3
# Bouncing ball calculation
# ---------------------------------------------------------

def problem3():
    print("\nProblem 3 - Bouncing Ball")

    height = float(input("Enter the initial height in meters: "))

    bounce = 0

    while height >= 0.001:
        height = height * 0.60
        bounce = bounce + 1

    print("The ball bounced", bounce, "times.")


# ---------------------------------------------------------
# Problem 4
# Animated bouncing ball
# ---------------------------------------------------------

def problem4():
    print("\nProblem 4 - Animated Bouncing Ball")

    height = float(input("Enter the initial height in meters: "))

    win = GraphWin("Bouncing Ball", 400, 400)

    # Set the coordinate system
    win.setCoords(0, 0, 10, height)

    # Create the ball
    radius = height * 0.03

    ball = Circle(Point(5, height), radius)
    ball.setFill("red")
    ball.draw(win)

    bounce = 0

    while height >= 0.001:

        # Move the ball downward
        steps = 20

        for i in range(steps):
            ball.move(0, -height / steps)
            time.sleep(0.03)

        # Move the ball upward
        for i in range(steps):
            ball.move(0, height / steps)
            time.sleep(0.03)

        bounce = bounce + 1

        # The next bounce reaches 60% of the previous height
        height = height * 0.60

    print("The ball bounced", bounce, "times.")

    win.getMouse()
    win.close()


# ---------------------------------------------------------
# Problem 5
# Euler's Totient Function
# ---------------------------------------------------------

def gcd(a, b):
    while b != 0:
        remainder = a % b
        a = b
        b = remainder

    return a


def phi(n):
    relativelyPrime = []

    for k in range(1, n):
        if gcd(n, k) == 1:
            relativelyPrime.append(k)

    return relativelyPrime


def problem5():
    print("\nProblem 5 - Euler's Totient Function")

    n = int(input("Enter a positive integer: "))

    result = phi(n)

    print("Numbers relatively prime to", n, "are:")
    print(result)

    print("The value of phi(", n, ") is", len(result))


