# PROBLEM 1: Multi-Ball Bouncing Simulation
# ==========================================
def run_multi_ball_simulation():
    if not GRAPHICS_AVAILABLE:
        print("\n[Error] Zelle's 'graphics.py' module is not installed or available.")
        print("Please ensure graphics.py is in your directory to run this simulation.")
        return

    print("\n--- Running Multi-Ball Bouncing Simulation ---")
    win = GraphWin("Three Bouncing Balls", 600, 600)
    win.setCoords(0, 0, 600, 600)
    
    num_balls = 3
    balls = []
    velocities = []
    radii = 20
    colors = ["red", "blue", "green"]
    
    for i in range(num_balls):
        x = random.randint(radii, 600 - radii)
        y = random.randint(radii, 600 - radii)
        ball = Circle(Point(x, y), radii)
        ball.setFill(colors[i])
        ball.draw(win)
        balls.append(ball)
        
        dx = random.choice([-4, -3, 3, 4])
        dy = random.choice([-4, -3, 3, 4])
        velocities.append([dx, dy])
        
    print("Simulation running. Click anywhere in the graphics window to exit.")
    while not win.checkMouse():
        for i in range(num_balls):
            ball = balls[i]
            dx, dy = velocities[i]
            ball.move(dx, dy)
            
            center = ball.getCenter()
            x, y = center.getX(), center.getY()
            
            if x - radii <= 0 or x + radii >= 600:
                velocities[i][0] = -dx
            if y - radii <= 0 or y + radii >= 600:
                velocities[i][1] = -dy
                
        time.sleep(0.02)
        
    win.close()


# ==========================================
# PROBLEM 2: Polybius Checkerboard Cipher
# ==========================================
POLYBIUS_BOARD = [
    ['A', 'B', 'C', 'D', 'E'],
    ['F', 'G', 'H', 'I', 'K'], # I and J share a cell
    ['L', 'M', 'N', 'O', 'P'],
    ['Q', 'R', 'S', 'T', 'U'],
    ['V', 'W', 'X', 'Y', 'Z']
]

def find_letter_coordinates(letter, board):
    letter = letter.upper()
    if letter == 'J':
        letter = 'I'
    for r_idx, row in enumerate(board):
        if letter in row:
            return (r_idx, row.index(letter))
    return None

def polybius_demo():
    print("\n--- Polybius Checkerboard Demo ---")
    msg = input("Enter a message to encode (e.g., PYTHON): ").strip()
    if not msg:
        msg = "PYTHON"
        
    # Encipher
    ciphertext = []
    for char in msg.upper():
        if char.isalpha():
            coords = find_letter_coordinates(char, POLYBIUS_BOARD)
            if coords:
                ciphertext.append(f"{coords[0]+1}{coords[1]+1}")
    encoded = " ".join(ciphertext)
    print(f"Enciphered: {encoded}")
    
    # Decipher
    plaintext = []
    for pair in encoded.split():
        r, c = int(pair[0]) - 1, int(pair[1]) - 1
        plaintext.append(POLYBIUS_BOARD[r][c])
    print(f"Deciphered: {''.join(plaintext)}")


