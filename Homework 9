# PROBLEM 3: Keyword Transposition Cipher
# ==========================================
def keyword_encipher_demo():
    print("\n--- Keyword Transposition Cipher Demo ---")
    message = input("Enter message (default: PROGRAMMINGWITHPYTHONISCOOL): ").strip()
    if not message:
        message = "PROGRAMMINGWITHPYTHONISCOOL"
    keyword = input("Enter keyword (default: PYTHON): ").strip()
    if not keyword:
        keyword = "PYTHON"
        
    cols = len(keyword)
    rows = (len(message) + cols - 1) // cols
    padded = message.ljust(rows * cols, 'X')
    
    # Build list of lists grid
    grid = []
    idx = 0
    for r in range(rows):
        row = []
        for c in range(cols):
            row.append(padded[idx])
            idx += 1
        grid.append(row)
        
    # Sort keyword columns alphabetically
    indexed_kw = sorted(list(enumerate(keyword.upper())), key=lambda x: x[1])
    
    cipher_parts = []
    for col_idx, _ in indexed_kw:
        col_chars = [grid[r][col_idx] for r in range(rows)]
        cipher_parts.append("".join(col_chars))
        
    result = " ".join(cipher_parts)
    print(f"Keyword Ciphertext: {result}")


